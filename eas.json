{
  "cli": {
    "version": ">= 12.6.2",
    "appVersionSource": "local",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CMS_URL": "https://ptsd-help-backend.staging.heroesof.tech"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_CMS_URL": "https://ptsd-help-backend.staging.heroesof.tech"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CMS_URL": "https://ptsd-help-backend.staging.heroesof.tech"
      }
    },
    "staging": {
      "channel": "staging",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "staging",
        "EXPO_PUBLIC_CMS_URL": "https://ptsd-help-backend.staging.heroesof.tech"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true
    },
    "production-apk": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
